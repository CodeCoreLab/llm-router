# llm-router — 根 .gitignore
# 原则：仓库只收录「源码 + 文档 + 配置样例 + 测试」。

# --- 通用编辑器 / IDE ---
.vscode/
.idea/
*.swp
*~
Thumbs.db
.DS_Store

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- 本地配置（真实密钥所在，永不入库；只提交 *.example.yaml）---
llm_endpoints.yaml
.env
*.local.sh

# --- 运行期产物 ---
logs/
data/
*.log
